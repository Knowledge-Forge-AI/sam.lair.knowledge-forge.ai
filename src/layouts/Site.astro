---
import '../styles/site.css';
import '../styles/theme.css';
import '../styles/material.css';
import '../styles/site-material-consumer.css';
const {title='Sam Lair — tools, ideas and the connections between', description='Samuel Leighton Lair’s personal workbench and journal. Agent engineering, repository intelligence, visual systems and release infrastructure.',article,noindex=false} = Astro.props;
const canonical=new URL(noindex && Astro.url.pathname==="/404/" ? "/404.html" : Astro.url.pathname,Astro.site);
const schema={ '@context':'https://schema.org', '@type':article?'BlogPosting':'WebSite',name:title,headline:title,description,url:canonical.href,author:{'@type':'Person',name:'Samuel Leighton Lair',url:Astro.site?.href},...(article?{datePublished:article.date,dateModified:article.updated}:{}) };
---
<!doctype html><html lang="en" data-theme="dark"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/>{noindex && <meta name="robots" content="noindex"/>}<meta name="color-scheme" content="dark light"/><meta name="theme-color" content="#030805"/><title>{title}</title><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg"/><link rel="alternate" type="application/rss+xml" title="Sam Lair’s journal" href="/journal/rss.xml"/><meta property="og:type" content={article?'article':'website'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\\u003c')}/><script is:inline>try{const t=localStorage.getItem('sam-site-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t;const p=localStorage.getItem('sam-site-transparency');if(p==='preserve'||p==='reduce')document.documentElement.dataset.tfReducedTransparency=p;}catch{}</script></head><body><a class="skip" href="#main">Skip to content</a><header class="site-header glass"><a class="wordmark" href="/" aria-label="Sam Lair home"><span aria-hidden="true"></span>Sam Lair</a><nav aria-label="Main navigation"><a href="/#work">Work</a><a href="/journal/" aria-current={Astro.url.pathname.startsWith('/journal/')?'page':undefined}>Journal</a><a href="/#about">About</a></nav><button class="theme-button" id="theme-button" type="button" aria-label="Switch to light appearance" hidden>Light</button><label class="transparency-control" hidden><span>Transparency</span><select id="transparency-select" name="transparency"><option value="system">System</option><option value="preserve">Preserve</option><option value="reduce">Reduce</option></select></label></header><main id="main"><slot/></main><footer class="site-footer shell"><a class="signature" href="/">Samuel Leighton Lair</a><nav aria-label="Footer"><a href="/journal/rss.xml">RSS</a><a href="https://github.com/Knowledge-Forge-AI/sam.lair.knowledge-forge.ai">Source</a><a href="/legal/">Licensing</a></nav></footer><script>
const button=document.querySelector<HTMLButtonElement>('#theme-button');
if(button){const update=()=>{const next=document.documentElement.dataset.theme==='light'?'Dark':'Light';button.textContent=next;button.setAttribute('aria-label',`Switch to ${next.toLowerCase()} appearance`);};update();button.hidden=false;button.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='light'?'dark':'light';document.documentElement.dataset.theme=next;try{localStorage.setItem('sam-site-theme',next);}catch{}update();});}
const transparency=document.querySelector<HTMLSelectElement>('#transparency-select');
const transparencyControl=transparency?.closest<HTMLElement>('.transparency-control');
if(transparency){const key='sam-site-transparency';const apply=(value:string)=>{if(value==='preserve'||value==='reduce')document.documentElement.dataset.tfReducedTransparency=value;else document.documentElement.removeAttribute('data-tf-reduced-transparency');transparency.value=value;};let saved='system';try{const stored=localStorage.getItem(key);if(stored==='system'||stored==='preserve'||stored==='reduce')saved=stored;}catch{}apply(saved);if(transparencyControl)transparencyControl.hidden=false;transparency.addEventListener('change',()=>{const next=transparency.value==='preserve'||transparency.value==='reduce'?transparency.value:'system';apply(next);try{localStorage.setItem(key,next);}catch{}});}
</script></body></html>
