    <a class="study-backlink" href="/study/">← Study materials</a>
    <div class="study-kicker"><span>Study</span><span>Lehman Chapter 4, Problem 22(b)</span></div>
    <h1>{title}</h1>
    <section class="study-mdx" set:html={lehmanNestedMarkup}></section>
    <section class="study-provenance">
      <h2>Source and attribution</h2>
