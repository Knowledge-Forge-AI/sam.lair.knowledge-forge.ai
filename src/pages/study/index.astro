---
import Site from '../../layouts/Site.astro';
import '../../styles/study.css';

const title = 'Study — algorithms and logic — Sam Lair';
const description = 'Selected study pages on recursive algorithms and propositional logic.';
const lessons = [
  {
    href: '/study/lehman-ch3-p4/',
    title: 'Lehman Chapter 3, Problem 4',
    summary: 'A proof study of a mixed-row recurrence.',
  },
  {
    href: '/study/goodrich-ch4-ex6-harmonic/',
    title: 'Goodrich Chapter 4, Exercise 6',
    summary: 'Recursive harmonic numbers and finite floating-point behavior.',
  },
  {
    href: '/study/rosen-1-3-ex5-6/',
    title: 'Rosen Section 1.3, Exercises 5 and 6',
    summary: 'Truth assignments for the distributive and De Morgan laws.',
  },
  {
    href: '/study/sedgewick-ch1-s4-ex10/',
    title: 'Sedgewick 1.4, Exercise 10',
    summary: 'Lower-bound binary search and the first matching index.',
  },
];
---

<Site title={title} description={description}>
  <article class="article study-article glass">
    <a class="back-link" href="/">← Sam Lair home</a>
    <div class="article-meta"><span>Study</span><span>Algorithms and logic</span></div>
    <h1>Selected study pages</h1>
    <p class="article-lead">Four pages on a recurrence, recursive harmonic numbers, finite propositional logic, and lower-bound binary search.</p>
    <nav aria-label="Study pages">
      <ul>
        {lessons.map((lesson) => <li><a href={lesson.href}><strong>{lesson.title}</strong></a><p>{lesson.summary}</p></li>)}
      </ul>
    </nav>
  </article>
</Site>
