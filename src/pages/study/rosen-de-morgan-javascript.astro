---
import Site from '../../layouts/Site.astro';
import '../../styles/study.css';
import source from '../../study/rosen-de-morgan.js.txt?raw';
import { RosenDeMorganInteractive, ROSEN_RUNNER } from '../../study/RosenDeMorganInteractive';

const title = "De Morgan's law in JavaScript — Sam Lair";
const description = 'Try the four truth assignments from Rosen Section 1.3 Exercise 6.';
const contentSecurityPolicy = [
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  "worker-src blob:",
  "connect-src 'self' " + ROSEN_RUNNER,
  "frame-src " + ROSEN_RUNNER,
].join('; ');
---

<Site title={title} description={description} contentSecurityPolicy={contentSecurityPolicy}>
  <article class="article study-article glass">
    <a class="back-link" href="/study/rosen-1-3-ex5-6/#rosen-1-3-ex6-solution">← Rosen Section 1.3, Exercise 6</a>
    <h1>De Morgan’s law in JavaScript</h1>
    <p class="article-lead">Compare the negation of a conjunction with the disjunction of its negated terms. The four rows cover every assignment to <code>p</code> and <code>q</code>.</p>
    <p>Each result row contains <code>p</code>, <code>q</code>, the left proposition, and the right proposition. With <code>"or"</code>, none of the rows disagree. With <code>"and"</code>, the two rows where exactly one input is true disagree.</p>
    <details>
      <summary>Read the starter code</summary>
      <pre><code>{source}</code></pre>
    </details>
    <RosenDeMorganInteractive client:visible source={source} />
    <section class="study-provenance" aria-labelledby="rosen-javascript-source">
      <h2 id="rosen-javascript-source">Source and licensing</h2>
      <p>The JavaScript example was written for this site. See the <a href="/study/provenance/rosen-1-3-ex5-6.json">source attribution for the Rosen exercise</a> and the <a href="/study/licenses/codemirror-NOTICES.txt">CodeMirror notices</a>.</p>
    </section>
  </article>
</Site>
