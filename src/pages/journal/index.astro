---
import Site from '../../layouts/Site.astro';
import Entries from '../../components/Entries.astro';
import {journalEntries} from '../../lib/journal';
const entries=await journalEntries();
const categories=[...new Set(entries.map(p=>p.category))].sort();
---
<Site title="Journal — Sam Lair" description="Personal notes on APGR, Common Lore Index, Theme Forge, DINAS and the work that connects them."><section class="journal-archive shell"><h1>Notes on what I’m building.</h1><p class="lead archive-intro">Releases, design decisions and the connections between projects.</p><p class="dating-note">Entries follow their release or milestone dates. Backfilled reflections identify when they were written; the original July APGR essay is preserved.</p><form class="journal-filters glass" id="journal-filters" role="search" hidden><div><label for="journal-search">Search the journal</label><input id="journal-search" type="search" placeholder="A project, release or idea…" autocomplete="off"/></div><div><label for="journal-category">Project</label><select id="journal-category"><option value="">All projects</option>{categories.map(category=><option value={category}>{category}</option>)}</select></div><button class="button secondary" type="reset">Clear filters</button></form><p id="journal-count" class="result-count" role="status">{entries.length} entries</p><div class="glass archive-entries"><Entries entries={entries} headingLevel="h2"/><p id="journal-empty" hidden>No entries match. Try another term or clear the filters.</p></div></section><script>
const form=document.querySelector<HTMLFormElement>('#journal-filters');const query=document.querySelector<HTMLInputElement>('#journal-search');const category=document.querySelector<HTMLSelectElement>('#journal-category');const rows=[...document.querySelectorAll<HTMLElement>('[data-entry]')];const count=document.querySelector('#journal-count');const empty=document.querySelector<HTMLElement>('#journal-empty');
if(form&&query&&category&&count&&empty){form.hidden=false;const filter=()=>{const terms=query.value.toLowerCase().trim().split(/\s+/).filter(Boolean);let n=0;for(const row of rows){const match=(!category.value||row.dataset.category===category.value)&&terms.every(t=>(row.dataset.search||'').includes(t));row.hidden=!match;if(match)n++;}count.textContent=`${n} ${n===1?'entry':'entries'}`;empty.hidden=n!==0;};query.addEventListener('input',filter);category.addEventListener('change',filter);form.addEventListener('submit',event=>event.preventDefault());form.addEventListener('reset',()=>{query.value='';category.value='';filter();});}
</script></Site>
