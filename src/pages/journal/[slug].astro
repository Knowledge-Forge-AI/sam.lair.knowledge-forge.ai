---
import {getCollection,render} from 'astro:content';
import Site from '../../layouts/Site.astro';
import {formatDate} from '../../lib/journal';
export async function getStaticPaths(){return (await getCollection('journal')).map(post=>({params:{slug:post.id},props:{post}}));}
const {post}=Astro.props;const {Content}=await render(post);
---
<Site title={`${post.data.title} — Sam Lair`} description={post.data.description} article={post.data}><article class="article glass"><a class="back-link" href="/journal/">← All journal entries</a><div class="article-meta"><time datetime={post.data.date}>{formatDate(post.data.date)}</time><span>{post.data.category}</span></div><h1>{post.data.title}</h1><p class="article-lead">{post.data.description}</p><div class="prose"><Content/></div><p class="retrospective">Retrospective written <time datetime={post.data.updated}>{formatDate(post.data.updated)}</time>; dated to the {post.data.kind==='release'?'release':'milestone'}.</p><section class="sources" aria-labelledby="sources-title"><h2 id="sources-title">Public records</h2><ul>{post.data.sources.map(source=><li><a href={source.url}>{source.label}</a></li>)}</ul></section></article></Site>
