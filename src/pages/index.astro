---
import Site from '../layouts/Site.astro';
import Arrow from '../components/Arrow.astro';
import Entries from '../components/Entries.astro';
import {journalEntries} from '../lib/journal';
const entries=(await journalEntries()).filter(p=>p.category!=='Common Lore Index').slice(0,3);
const projects=[
['Agentic Praxis Grimoire','Tools and skills for bounded agent engineering.','Explore APGR','https://www.knowledge-forge.ai/apgr/','green'],
['Common Lore Index','Evidence-linked repository graphs. Currently RepoMap.','Explore CLOE','https://github.com/Knowledge-Forge-AI/repo-map','cyan'],
['Theme Forge','Assets, themes and a workbench for visual systems.','Explore Theme Forge','https://tfnf.knowledge-forge.ai/','purple'],
['DINAS','A modular, inspectable nix-darwin workstation.','Explore DINAS','https://github.com/Knowledge-Forge-AI/darwin-is-not-a-snowflake','amber'],
['Release Starport 9','Connecting upstream releases to package distribution.','Explore RS9','https://rs9.knowledge-forge.ai/','cyan']];
---
<Site><section class="hero shell" aria-labelledby="intro"><div class="hero-copy"><h1 id="intro"><span>I build tools.</span><span>I connect the dots.</span></h1><p class="lead">I’m Samuel Leighton Lair. I work on agent engineering, repository intelligence, visual systems and the infrastructure that connects them.</p><div class="hero-actions"><a class="button primary" href="/journal/">Read my journal <Arrow/></a><a class="button secondary" href="#work">Explore my work</a></div></div><div class="portrait-stage"><div class="portrait-glass" aria-hidden="true"><i></i></div><img src="/sam-lair.webp" alt="Anime portrait of Sam: short brown hair, blue eyes, glasses and a burgundy shirt." width="1024" height="1536" fetchpriority="high" decoding="async"/><span class="portrait-reflection" aria-hidden="true"></span></div></section><section id="work" class="work shell" aria-labelledby="work-title"><h2 id="work-title">From my workbench.</h2><p class="section-intro">Different projects. The same curiosity about how things fit together.</p><div class="projects">{projects.map(([name,description,label,url,color])=><article class={`project ${color}`}><h3>{name}</h3><p>{description}</p><a href={url}>{label}<Arrow/></a></article>)}</div></section><section class="journal-preview shell glass" aria-labelledby="journal-title"><div class="section-heading"><h2 id="journal-title">Notes on what I’m building.</h2><a href="/journal/">All entries <Arrow/></a></div><Entries entries={entries}/></section><section id="about" class="about shell" aria-labelledby="about-title"><div><h2 id="about-title">Curiosity, with receipts.</h2><p>My work spans agent engineering, repository intelligence and visual systems. I care about software that can explain what it did—and show its inputs and limits.</p></div><nav aria-label="Find me"><a href="https://www.knowledge-forge.ai/">Knowledge Forge AI <Arrow/></a><a href="https://github.com/lair001">GitHub <Arrow/></a><a href="mailto:sam.lair@knowledge-forge.ai">Contact <Arrow/></a></nav></section></Site>
