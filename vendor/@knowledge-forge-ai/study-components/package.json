{
  "name": "@knowledge-forge-ai/study-components",
  "version": "0.0.0-private.1",
  "private": true,
  "description": "Private optional study document, editor, and runtime source closure",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "COMMERCIAL-LICENSE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/document-registry.d.ts",
      "import": "./dist/document-registry.js"
    },
    "./registry": {
      "types": "./dist/document-registry.d.ts",
      "import": "./dist/document-registry.js"
    },
    "./mdx": {
      "types": "./dist/mdx-document.d.ts",
      "import": "./dist/mdx-document.js"
    },
    "./semantic": {
      "types": "./dist/semantic-components.d.ts",
      "import": "./dist/semantic-components.js"
    },
    "./runner": {
      "types": "./dist/browser-runner.d.ts",
      "import": "./dist/browser-runner.js"
    },
    "./dom": {
      "types": "./dist/browser-dom-host.d.ts",
      "import": "./dist/browser-dom-host.js"
    },
    "./editor": {
      "types": "./dist/study-editor.d.ts",
      "import": "./dist/study-editor.js"
    },
    "./runtime": {
      "types": "./dist/study-runtime-controller.d.ts",
      "import": "./dist/study-runtime-controller.js"
    },
    "./runtime-protocol": {
      "types": "./dist/study-runtime-protocol.d.ts",
      "import": "./dist/study-runtime-protocol.js"
    },
    "./runtime-host": {
      "types": "./dist/separate-origin-runtime-host.d.ts",
      "import": "./dist/separate-origin-runtime-host.js"
    },
    "./runtime-adapter": {
      "types": "./dist/study-runtime-editor-adapter.d.ts",
      "import": "./dist/study-runtime-editor-adapter.js"
    },
    "./editor-execution": {
      "types": "./dist/study-editor-execution.d.ts",
      "import": "./dist/study-editor-execution.js"
    },
    "./typescript": {
      "types": "./dist/study-typescript-execution-adapter.d.ts",
      "import": "./dist/study-typescript-execution-adapter.js"
    },
    "./runtime-frame": {
      "types": "./dist/study-runtime-frame.d.ts",
      "import": "./dist/study-runtime-frame.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "overrides": {
    "katex": "0.19.1"
  },
  "peerDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@mdx-js/mdx": "3.1.1",
    "katex": "0.19.1",
    "react": ">=19.2.8 <20",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/commands": {
      "optional": true
    },
    "@codemirror/lang-javascript": {
      "optional": true
    },
    "@codemirror/lang-python": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@mdx-js/mdx": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "rehype-katex": {
      "optional": true
    },
    "remark-math": {
      "optional": true
    }
  }
}
